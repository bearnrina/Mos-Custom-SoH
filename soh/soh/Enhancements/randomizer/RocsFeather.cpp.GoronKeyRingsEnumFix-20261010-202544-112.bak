extern PlayState* gPlayState;
// OTRGlobals.h exposes this declaration only to C translation units.
GetItemEntry ItemTable_RetrieveEntry(s16 modIndex, s16 getItemID);
}

#define MAX_ROCS_USES 1

static uint8_t rocsUseCount = 0;
static uint8_t groundTimer = 0;
static f32 effectsScale = 1.0f;

// Goron shop key rings use normal-save progression and never consult seed dungeon settings.
struct GoronShopRing {
    s16 randomizerGet;
    s16 ownershipFlag;
    s16 scene;
    u8 vanillaKeys;
    u8 mqKeys;
    s16 medallion;
    const char* name;
};
static const GoronShopRing goronShopRings[GORON_KEY_RING_SHOP_COUNT] = {
    { RG_FOREST_TEMPLE_KEY_RING, RAND_INF_OBTAINED_SHOP_FOREST_TEMPLE_KEY_RING, SCENE_FOREST_TEMPLE, 5, 6, QUEST_MEDALLION_FOREST, "Forest Temple" },
    { RG_FIRE_TEMPLE_KEY_RING, RAND_INF_OBTAINED_SHOP_FIRE_TEMPLE_KEY_RING, SCENE_FIRE_TEMPLE, 8, 5, QUEST_MEDALLION_FIRE, "Fire Temple" },
    { RG_WATER_TEMPLE_KEY_RING, RAND_INF_OBTAINED_SHOP_WATER_TEMPLE_KEY_RING, SCENE_WATER_TEMPLE, 6, 2, QUEST_MEDALLION_WATER, "Water Temple" },
    { RG_SPIRIT_TEMPLE_KEY_RING, RAND_INF_OBTAINED_SHOP_SPIRIT_TEMPLE_KEY_RING, SCENE_SPIRIT_TEMPLE, 5, 7, QUEST_MEDALLION_SPIRIT, "Spirit Temple" },
    { RG_SHADOW_TEMPLE_KEY_RING, RAND_INF_OBTAINED_SHOP_SHADOW_TEMPLE_KEY_RING, SCENE_SHADOW_TEMPLE, 5, 6, QUEST_MEDALLION_SHADOW, "Shadow Temple" },
    { RG_BOTTOM_OF_THE_WELL_KEY_RING, RAND_INF_OBTAINED_SHOP_BOTTOM_OF_THE_WELL_KEY_RING, SCENE_BOTTOM_OF_THE_WELL, 3, 2, -1, "Bottom of the Well" },
    { RG_GERUDO_TRAINING_GROUND_KEY_RING, RAND_INF_OBTAINED_SHOP_GERUDO_TRAINING_GROUND_KEY_RING, SCENE_GERUDO_TRAINING_GROUND, 9, 3, -1, "Gerudo Training Ground" },
    { RG_GERUDO_FORTRESS_KEY_RING, RAND_INF_OBTAINED_SHOP_GERUDO_FORTRESS_KEY_RING, SCENE_THIEVES_HIDEOUT, 4, 4, -1, "Gerudo Fortress" },
    { RG_GANONS_CASTLE_KEY_RING, RAND_INF_OBTAINED_SHOP_GANONS_CASTLE_KEY_RING, SCENE_INSIDE_GANONS_CASTLE, 2, 3, -1, "Ganon's Castle" },
};

extern "C" s32 GoronKeyRingsShop_GetIndex(s16 shopItemId) {
    s32 index = shopItemId - GORON_KEY_RING_SHOP_FIRST_ID;
    return index >= 0 && index < GORON_KEY_RING_SHOP_COUNT ? index : -1;
}

extern "C" s16 GoronKeyRingsShop_GetRandomizerGet(s16 shopItemId) {
    s32 index = GoronKeyRingsShop_GetIndex(shopItemId);
    return index >= 0 ? goronShopRings[index].randomizerGet : RG_NONE;
}

static bool GoronKeyRingsShop_HasMedallion(s16 medallion) {
    return medallion >= 0 && CHECK_QUEST_ITEM(medallion);
}

extern "C" s16 GoronKeyRingsShop_GetStock(void) {
    // The Light Medallion also keeps the shop unlocked after returning to childhood.
    if (IS_RANDO || (!LINK_IS_ADULT && !CHECK_QUEST_ITEM(QUEST_MEDALLION_LIGHT))) {
        return -1;
    }
    s32 primary = 0;
    if (CHECK_QUEST_ITEM(QUEST_MEDALLION_FOREST) && CHECK_QUEST_ITEM(QUEST_MEDALLION_FIRE) &&
        CHECK_QUEST_ITEM(QUEST_MEDALLION_WATER) && CHECK_QUEST_ITEM(QUEST_MEDALLION_SPIRIT) &&
        CHECK_QUEST_ITEM(QUEST_MEDALLION_SHADOW) && CHECK_QUEST_ITEM(QUEST_MEDALLION_LIGHT)) {
        primary = 8;
    } else if (CHECK_QUEST_ITEM(QUEST_MEDALLION_SHADOW)) {
        primary = 3;
    } else if (CHECK_QUEST_ITEM(QUEST_MEDALLION_WATER)) {
        primary = 4;
    } else if (CHECK_QUEST_ITEM(QUEST_MEDALLION_FIRE)) {
        primary = 2;
    } else if (CHECK_QUEST_ITEM(QUEST_MEDALLION_FOREST)) {
        primary = 1;
    }
    const GoronShopRing& ring = goronShopRings[primary];
    if (!Flags_GetRandomizerInf(ring.ownershipFlag) && !GoronKeyRingsShop_HasMedallion(ring.medallion)) {
        return GORON_KEY_RING_SHOP_FIRST_ID + primary;
    }
    // Fallback order: Well, Fortress, Training Ground. Purchased rings never return.
    const s32 fallback[] = { 5, 7, 6 };
    for (s32 index : fallback) {
        if (!Flags_GetRandomizerInf(goronShopRings[index].ownershipFlag)) {
            return GORON_KEY_RING_SHOP_FIRST_ID + index;
        }
    }
    return -1;
}

extern "C" GetItemEntry GoronKeyRingsShop_GetItemEntry(s16 shopItemId) {
    s32 index = GoronKeyRingsShop_GetIndex(shopItemId);
    GetItemEntry entry = ItemTable_RetrieveEntry(MOD_RANDOMIZER, index >= 0 ? goronShopRings[index].randomizerGet : RG_NONE);
    if (index >= 0) {
        entry.getItemId = goronShopRings[index].randomizerGet;
        entry.textId = TEXT_GORON_KEY_RING_PICKUP_BASE + index;
    }
    return entry;
}

extern "C" s32 GoronKeyRingsShop_IsPickup(GetItemEntry entry) {
    s32 index = entry.textId - TEXT_GORON_KEY_RING_PICKUP_BASE;
    return index >= 0 && index < GORON_KEY_RING_SHOP_COUNT &&
           entry.getItemId == goronShopRings[index].randomizerGet;
}

extern "C" void GoronKeyRingsShop_Give(s16 randomizerGet) {
    if (IS_RANDO) {
        return;
    }
    for (const GoronShopRing& ring : goronShopRings) {
        if (ring.randomizerGet == randomizerGet) {
            if (Flags_GetRandomizerInf(ring.ownershipFlag)) {
                return;
            }
            s32 count = IS_MASTER_QUEST ? ring.mqKeys : ring.vanillaKeys;
            // Never reduce existing keys or recorded totals; a ring supplies one full set.
            if (gSaveContext.inventory.dungeonKeys[ring.scene] < count) {
                gSaveContext.inventory.dungeonKeys[ring.scene] = count;
            }
            if (gSaveContext.ship.stats.dungeonKeys[ring.scene] < count) {
                gSaveContext.ship.stats.dungeonKeys[ring.scene] = count;
            }
            Flags_SetRandomizerInf(ring.ownershipFlag);
            return;
        }
    }
}

extern "C" GetItemEntry FishingPoleShop_GetItemEntry(void) {
    GetItemEntry entry = ItemTable_RetrieveEntry(MOD_RANDOMIZER, RG_FISHING_POLE);
    entry.getItemId = RG_FISHING_POLE;
    entry.textId = TEXT_FISHING_POLE_SHOP_PICKUP;
    return entry;
}

extern "C" s32 FishingPoleShop_IsRequired(void) {
    return !IS_RANDO && CVarGetInteger(CVAR_ENHANCEMENT("FishingPoleInZoraShop"), 0);
}

extern "C" s32 FishingPoleShop_IsBlocked(void) {
    return FishingPoleShop_IsRequired() && !Flags_GetRandomizerInf(RAND_INF_FISHING_POLE_FOUND);
}

extern "C" GetItemEntry SkeletonKeyShop_GetItemEntry(void) {
    GetItemEntry entry = ItemTable_RetrieveEntry(MOD_RANDOMIZER, RG_SKELETON_KEY);
    // The native item definition uses a Stone of Agony get-item ID for its model.
    // Give it a distinct ID/text pair so normal saves take our ownership path.
    entry.getItemId = RG_SKELETON_KEY;
    entry.textId = TEXT_SKELETON_KEY_SHOP_PICKUP;
    return entry;
}

extern "C" s32 SkeletonKeyShop_UnlocksDoors(PlayState* play) {
    // The shop toggle controls availability; a purchased key stays useful.
    // Treasure Chest Game keys retain their normal minigame rules.
    return play != nullptr && !IS_RANDO && play->sceneNum != SCENE_TREASURE_BOX_SHOP &&
           Flags_GetRandomizerInf(RAND_INF_OBTAINED_SHOP_SKELETON_KEY);
}

void RegisterRocsFeather() {
    // Always register hooks - they only activate when ITEM_ROCS_FEATHER is actually used
    // Rando-specific logic (item pool, accessibility, etc.) is handled elsewhere
    bool shouldRegister = true;

    // These IDs are used only by the enhancement's shop item, including its pickup message.
    COND_HOOK(OnOpenText, shouldRegister, [](u16* textId, bool* loadFromMessageTable) {
        std::string text;
        s32 ringIndex = *textId - TEXT_GORON_KEY_RING_DESC_BASE;
        if (ringIndex >= 0 && ringIndex < GORON_KEY_RING_SHOP_COUNT) {
            text = std::string(goronShopRings[ringIndex].name) + " Key Ring&200 Rupees&All small keys for this area.&One per customer.";
            text += "\x0B";
        } else if ((ringIndex = *textId - TEXT_GORON_KEY_RING_PROMPT_BASE) >= 0 && ringIndex < GORON_KEY_RING_SHOP_COUNT) {
            text = std::string(goronShopRings[ringIndex].name) + " Key Ring&200 Rupees&" +
                   CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
        } else if ((ringIndex = *textId - TEXT_GORON_KEY_RING_PICKUP_BASE) >= 0 && ringIndex < GORON_KEY_RING_SHOP_COUNT) {
            text = std::string("You got the ") + goronShopRings[ringIndex].name + "&Key Ring!&You received a full set&of its small keys.";
        } else switch (*textId) {
            case TEXT_ROCS_FEATHER_SHOP_DESC:
                text = "Roc's Feather  99 Rupees&Equip this feather to jump.&Usable by Child and Adult Link.&One per customer.";
                // OoT's EVENT control code: shop browsing waits for TEXT_STATE_EVENT.
                text += "\x0B";
                break;
            case TEXT_ROCS_FEATHER_SHOP_PROMPT:
                text = "Roc's Feather  99 Rupees&Buy this feather?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
                break;
            case TEXT_ROCS_FEATHER_SHOP_PICKUP:
                text = "You got Roc's Feather!&Equip it to an item button&and press it to jump.&It works for both ages.";
                break;
            case TEXT_BOMBCHU_BAG_SHOP_DESC:
                text = "Bombchu Bag  200 Rupees&Own this bag to use Bombchus.&Bombchus are sold separately.&One per customer.";
                text += "\x0B";
                break;
            case TEXT_BOMBCHU_BAG_SHOP_PROMPT:
                text = "Bombchu Bag  200 Rupees&Buy this bag?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
                break;
            case TEXT_BOMBCHU_BAG_SHOP_PICKUP:
                text = "You got a Bombchu Bag!&You can now use Bombchus.&Your stored supply is ready.&Buy more when you run out.";
                break;
            case TEXT_TYCOON_WALLET_SHOP_DESC:
                text = "Tycoon Wallet  500 Rupees&Holds up to 999 Rupees.&Requires the Giant's Wallet.&One per customer.";
                text += "\x0B";
                break;
            case TEXT_TYCOON_WALLET_SHOP_PROMPT:
                text = "Tycoon Wallet  500 Rupees&Buy this wallet?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
                break;
            case TEXT_TYCOON_WALLET_SHOP_PICKUP:
                text = "You got a Tycoon Wallet!&You can now carry&up to 999 Rupees!";
                break;
            case TEXT_FISHING_POLE_SHOP_DESC:
                text = "Fishing Pole  200 Rupees&Bring your own pole to fish&at the Fishing Pond.&One per customer.";
                text += "\x0B";
                break;
            case TEXT_FISHING_POLE_SHOP_PROMPT:
                text = "Fishing Pole  200 Rupees&Buy this pole?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
                break;
            case TEXT_FISHING_POLE_SHOP_PICKUP:
                text = "You got a Fishing Pole!&You can now fish at the&Fishing Pond with your own pole.&It works for both ages.";
                break;
            case TEXT_FISHING_POLE_OWNER_NO_POLE:
                text = "I'm out of fishing poles&to rent! Bring your own&if you want to fish here.";
                break;
            case TEXT_FISHING_POLE_OWNER_START:
                text = "Brought your own pole?&It's 20 Rupees to fish here.&Want to give it a try?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Yes&No";
                break;
            case TEXT_SKELETON_KEY_SHOP_DESC:
                text = "Skeleton Key  999 Rupees&Unlocks small-key doors.&Boss keys are still required.&One per customer.";
                text += "\x0B";
                break;
            case TEXT_SKELETON_KEY_SHOP_PROMPT:
                text = "Skeleton Key  999 Rupees&Buy this key?&" +
                       CustomMessage::TWO_WAY_CHOICE() + "Buy&Don't buy";
                break;
            case TEXT_SKELETON_KEY_SHOP_PICKUP:
                text = "You got the Skeleton Key!&Small-key doors can now be&unlocked without using keys.&Boss keys are still required.";
                break;
            case TEXT_FOREST_CHILD_WALLET_PICKUP:
                text = "You found a Child's Wallet!&You can now carry&up to 99 Rupees!";
                break;
            default:
                return;
        }
        // Use the same English description as a fallback in the other supported languages.
        CustomMessage message(text, text, text);
        message.Format();
        message.LoadIntoFont();
        *loadFromMessageTable = false;
    });

    COND_HOOK(OnPlayerUpdate, shouldRegister, []() {
        Player* player = GET_PLAYER(gPlayState);

        // Reset Rocs count when touching the ground for 3+ frames
        if (player->actor.bgCheckFlags & 1) {
            if (groundTimer <= 3) {
                groundTimer++;
            }
        } else {
            groundTimer = 0;
        }

        if (groundTimer >= 3) {
            rocsUseCount = 0;
        }
    });

    COND_VB_SHOULD(VB_CHANGE_HELD_ITEM_AND_USE_ITEM, shouldRegister, {
        int32_t usedItem = va_arg(args, int32_t);

        // Roc's Feather behaviour
        if (usedItem == ITEM_ROCS_FEATHER) {
            *should = false;

            if (rocsUseCount < MAX_ROCS_USES) {
                rocsUseCount++;

                Player* player = GET_PLAYER(gPlayState);

                func_80838940(player, (LinkAnimationHeader*)&gPlayerAnim_link_rocs_feather_jump, 5.8f, gPlayState, 0);

                // Actionvar needed to prevent weird animation morph
                player->av2.actionVar2 = 1;

                // Move player forward on Roc's use
                player->linearVelocity = 5.0f;
                player->actor.world.rot.y = player->yaw = player->actor.shape.rot.y;

                if (gSaveContext.linkAge == LINK_AGE_CHILD) {
                    player->actor.velocity.y = 7.0f;
                    effectsScale = 1.0f;
                } else {
                    player->actor.velocity.y = 7.5f;
                    effectsScale = 1.5f;
                }

                Vec3f effectsPos = player->actor.home.pos;
                effectsPos.y += 3;

                EffectSsGRipple_Spawn(gPlayState, &effectsPos, static_cast<s16>(200 * effectsScale),
                                      static_cast<s16>(300 * effectsScale), 1);
                EffectSsGSplash_Spawn(gPlayState, &effectsPos, NULL, NULL, 0, static_cast<s16>(150 * effectsScale));

                // Remove hopping state when using Roc's after sidehop/backflip to allow grabbing ledges again
                player->stateFlags2 &= ~(PLAYER_STATE2_HOPPING);

                Player_PlaySfx(&player->actor, NA_SE_PL_SKIP);
            }
        }
    });

    COND_VB_SHOULD(VB_DRAW_CUSTOM_ITEM_NAME, shouldRegister, {
        u32 namedItem = va_arg(args, u32);
        if (namedItem == ITEM_ROCS_FEATHER) {
            *should = true;
            const char* textureName = gRocsFeatherItemNameENGTex;

            if (gSaveContext.language == LANGUAGE_GER) {
                textureName = gRocsFeatherItemNameGERTex;
            } else if (gSaveContext.language == LANGUAGE_FRA) {
                textureName = gRocsFeatherItemNameFRATex;
            }

            memcpy(gPlayState->pauseCtx.nameSegment, textureName, strlen(textureName) + 1);
        }
    });
}

static RegisterShipInitFunc registerRocsFeather(RegisterRocsFeather);
